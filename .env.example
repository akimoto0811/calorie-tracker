# Copy this file to .env.local for local development.
# On Vercel, add the same names under Project → Settings → Environment Variables.

# From Supabase: Project Settings → API (or the "Connect" button → App Frameworks)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Which AI reads nutrition label photos. Only "gemini" is built in for now.
AI_PROVIDER=gemini

# From Google AI Studio: https://aistudio.google.com/apikey  (server-side only, never shown to users)
GEMINI_API_KEY=your-gemini-api-key
# Optional: override the model
# GEMINI_MODEL=gemini-2.5-flash
